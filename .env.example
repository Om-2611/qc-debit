# Copy to `.env` (repo root) and adjust. The API loads this file on start.

# --- Postgres (docker-compose) ---
POSTGRES_USER=dalmia
POSTGRES_PASSWORD=dalmia_dev
POSTGRES_DB=dalmia_qc
POSTGRES_PORT=5433

# --- API ---
DATABASE_URL=postgresql://dalmia:dalmia_dev@localhost:5433/dalmia_qc?schema=public
# Separate database used by `pnpm --filter @dalmia/api test` (created automatically).
TEST_DATABASE_URL=postgresql://dalmia:dalmia_dev@localhost:5433/dalmia_qc_test?schema=public
API_PORT=4000
WEB_ORIGIN=http://localhost:5173
NODE_ENV=development

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7

# --- Seed ---
# Password given to every seeded user. Change it (and the users' passwords) before going live.
SEED_DEFAULT_PASSWORD=ChangeMe@123

# Web Push (browser notifications for hand-offs). Generate once per deployment and keep the private key secret:
#   pnpm --filter @dalmia/api vapid:keys
# Leave blank to turn push off (the in-app bell still works). Changing the keys means every user must turn
# notifications on again. VAPID_SUBJECT is a contact address the push services can use.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@dalmiapolypro.in

# --- TCS iON push ("Load on TCS iON"); see docs/ion-push.md ---
# Off everywhere until the accountant and IT have signed off. While off, no job is created or handed to the worker.
ION_PUSH_ENABLED=false
# training | live: which iON the jobs created here are for.
ION_ENV=training
# dry_run | draft_only | full. Blank = draft_only (every job stops before Submit). Set full explicitly to let jobs Submit. On live this is the only mode.
ION_RUN_MODE=
# Shared secret of the worker PC (Authorization: Bearer ...). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ION_WORKER_TOKEN=
# A running job whose worker is silent this long counts as dead; transient failures re-queue this many times before the draft exists.
ION_HEARTBEAT_TIMEOUT_SECONDS=120
ION_MAX_AUTO_RETRIES=2
# Successful pushes keep only their final screenshot after this many days (failed / check_manually pushes keep all).
ION_SCREENSHOT_RETENTION_DAYS=30
