generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------------ enums

enum Role {
  GATE
  RM_STORE
  QC_ANALYST
  /// Raises the GRN after QC, before the Purchase Manager.
  STORES
  QC_MANAGER
  ADMIN
}

enum ReportStatus {
  DRAFT
  /// Gate has submitted the header and the "As per Supplier Invoice" rows; waiting for the Raw Material Store.
  INVOICE_ENTERED
  WEIGHTS_ENTERED
  QC_ENTERED
  PENDING_APPROVAL
  APPROVED
}

enum ReportSource {
  MANUAL
  IMPORTED
}

enum ParameterCategory {
  DISCRETIONARY
  NON_DISCRETIONARY
}

enum InputMode {
  KG_PER_BALE
  PERCENT_PER_BALE
}

enum RateMode {
  DOMINANT_MATERIAL_RATE
  DOMINANT_MATERIAL_RATE_MINUS_20
  /// Sheet O36/O37: =$E$20-20
  CLEAR_RATE_MINUS_20
  FIXED
}

enum WeightBase {
  TOTAL_DALMIA_WEIGHT
  CLEAR_WEIGHT
  /// "No. of Bales" (column M) x average bale weight of the truck (M18 / M19) - sheet row 28
  AFFECTED_BALES_TRUCK_AVG
  /// "No. of Bales" x average weight of the sampled bales - sheet row 30
  AFFECTED_BALES_SAMPLE_AVG
}

// ------------------------------------------------------------------ users & auth

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  /// false = rates and every rupee figure are stripped from what this user receives (weights, readings and quantities remain).
  canSeeRates  Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  refreshTokens     RefreshToken[]
  reportsCreated    Report[]           @relation("ReportCreatedBy")
  reportsChecked    Report[]           @relation("ReportCheckedBy")
  reportsApproved   Report[]           @relation("ReportApprovedBy")
  importBatches     ImportBatch[]
  auditLogs         AuditLog[]
  notifications     Notification[]
  pushSubscriptions PushSubscription[]
}

/// One row per issued refresh token. Tokens rotate on every refresh; only a SHA-256 hash is stored.
model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  /// All tokens descended from one login share a family; reuse of a rotated token revokes the family.
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())
  userAgent String?

  @@index([userId])
  @@index([familyId])
}

// ------------------------------------------------------------------ master data

model Supplier {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  gstin     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  reports Report[]
}

model Material {
  id        String  @id @default(cuid())
  /// Stable key used by the calculation engine (CLEAR, GREEN, BARWASTE, BARWASTE_WITH_RING, OTHERS).
  code      String  @unique
  name      String  @unique
  sortOrder Int
  isActive  Boolean @default(true)

  reportLines   ReportMaterialLine[]
  shortageLines ShortageLine[]
}

model Parameter {
  id           String            @id @default(cuid())
  code         String            @unique
  name         String
  category     ParameterCategory
  inputMode    InputMode
  sortOrder    Int
  isActive     Boolean           @default(true)
  /// false = reading is recorded and highlighted but never raises a deduction (rows with no formula in the old sheet).
  isDeductible Boolean           @default(true)

  norms      NormRule[]
  rates      RateRule[]
  readings   QcReading[]
  deductions Deduction[]
}

model NormRule {
  id               String    @id @default(cuid())
  parameterId      String
  parameter        Parameter @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  /// 1–12; a season may wrap the year end (10 → 6 = Oct–Jun). 1 → 12 = all year.
  seasonStartMonth Int
  seasonEndMonth   Int
  normPercent      Decimal   @db.Decimal(8, 4)
  effectiveFrom    DateTime  @db.Date

  @@index([parameterId])
}

model RateRule {
  id               String     @id @default(cuid())
  parameterId      String
  parameter        Parameter  @relation(fields: [parameterId], references: [id], onDelete: Cascade)
  rateMode         RateMode
  fixedRate        Decimal?   @db.Decimal(12, 4)
  weightBase       WeightBase
  /// Sheet Q28: the amount is charged only while actual % is below this (Dirty bottle: 6)
  maxActualPercent Decimal?   @db.Decimal(8, 4)
  effectiveFrom    DateTime   @db.Date

  @@index([parameterId])
}

/// Global key/value settings: toleranceFraction, useWeightToleranceRow, allowNegativeOtherShortage …
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// ------------------------------------------------------------------ reports

model Report {
  id       String       @id @default(cuid())
  reportNo String       @unique
  status   ReportStatus @default(DRAFT)
  source   ReportSource @default(MANUAL)

  reportDate    DateTime  @db.Date
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id])
  /// Party name exactly as typed / as found in the imported sheet.
  partyNameRaw  String?
  poNumber      String?
  truckNumber   String?
  grnNumber     String?
  tokenDate     DateTime? @db.Date
  tokenNumber   String?
  invoiceNumber String?
  invoiceDate   DateTime? @db.Date

  weightTolerancePercent Decimal? @db.Decimal(8, 4)
  remarks                String?
  sentBackNote           String?
  reopenReason           String?

  checkedById    String?
  checkedBy      User?     @relation("ReportCheckedBy", fields: [checkedById], references: [id])
  approvedById   String?
  approvedBy     User?     @relation("ReportApprovedBy", fields: [approvedById], references: [id])
  approvedAt     DateTime?
  /// Free-text names from imported sheets (row 53), where no app user exists.
  checkedByName  String?
  approvedByName String?

  // Snapshot totals (row 49) for fast listing and dashboards.
  standardTotal Decimal @default(0) @db.Decimal(16, 4)
  approvedTotal Decimal @default(0) @db.Decimal(16, 4)
  /// Tally narration, frozen at approval.
  narration     String?

  // Excel import bookkeeping
  importBatchId   String?
  importBatch     ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  importSheetName String?
  /// Engine's Total (A+B+C) approved amount on the imported inputs; compared with the sheet's own total.
  recomputedTotal Decimal?     @db.Decimal(16, 4)
  hasMismatch     Boolean      @default(false)
  mismatchDetail  Json?

  createdById String
  createdBy   User     @relation("ReportCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  materialLines ReportMaterialLine[]
  bales         ReportBale[]
  readings      QcReading[]
  deductions    Deduction[]
  shortageLines ShortageLine[]
  auditLogs     AuditLog[]
  notifications Notification[]

  @@index([status])
  @@index([supplierId])
  @@index([reportDate])
  @@index([grnNumber])
  @@index([truckNumber, invoiceNumber])
  @@index([importBatchId])
}

model ReportMaterialLine {
  reportId        String
  report          Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  materialId      String
  material        Material @relation(fields: [materialId], references: [id])
  invoiceWeightKg Decimal? @db.Decimal(14, 4)
  invoiceBales    Decimal? @db.Decimal(10, 2)
  invoiceRate     Decimal? @db.Decimal(12, 4)
  dalmiaWeightKg  Decimal? @db.Decimal(14, 4)
  dalmiaBales     Decimal? @db.Decimal(10, 2)
  dalmiaRate      Decimal? @db.Decimal(12, 4)

  @@id([reportId, materialId])
}

model ReportBale {
  reportId     String
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  /// 1..3
  baleIndex    Int
  baleWeightKg Decimal? @db.Decimal(12, 4)

  @@id([reportId, baleIndex])
}

model QcReading {
  reportId    String
  report      Report    @relation(fields: [reportId], references: [id], onDelete: Cascade)
  parameterId String
  parameter   Parameter @relation(fields: [parameterId], references: [id])
  baleIndex   Int
  /// kg or % depending on parameter.inputMode
  value       Decimal?  @db.Decimal(12, 4)

  @@id([reportId, parameterId, baleIndex])
}

/// Snapshot of engine output (or of the sheet's own figures for imports) at save time, so
/// historical reports do not change when norms/rates are edited later.
model Deduction {
  reportId           String
  report             Report     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  parameterId        String
  parameter          Parameter  @relation(fields: [parameterId], references: [id])
  normPercent        Decimal    @db.Decimal(8, 4)
  totalKg            Decimal?   @db.Decimal(12, 4)
  actualPercent      Decimal    @db.Decimal(10, 4)
  purchaseAdjustment Decimal    @default(0) @db.Decimal(8, 4)
  /// "No. of Bales" affected (sheet column M) - an input, used by per-affected-bale parameters
  affectedBales      Decimal?   @db.Decimal(10, 2)
  rate               Decimal    @db.Decimal(12, 4)
  weightBase         WeightBase
  isDeductible       Boolean    @default(true)
  standardQty        Decimal    @db.Decimal(14, 4)
  standardAmount     Decimal    @db.Decimal(16, 4)
  approvedQty        Decimal    @db.Decimal(14, 4)
  approvedAmount     Decimal    @db.Decimal(16, 4)
  differenceQty      Decimal    @db.Decimal(14, 4)
  differenceAmount   Decimal    @db.Decimal(16, 4)

  @@id([reportId, parameterId])
}

model ShortageLine {
  reportId         String
  report           Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  materialId       String
  material         Material @relation(fields: [materialId], references: [id])
  shortageQty      Decimal  @db.Decimal(14, 4)
  rate             Decimal  @db.Decimal(12, 4)
  standardAmount   Decimal  @db.Decimal(16, 4)
  approvedQty      Decimal  @db.Decimal(14, 4)
  approvedAmount   Decimal  @db.Decimal(16, 4)
  /// Manager's adjustment in kg (input, not output).
  adjustment       Decimal? @db.Decimal(14, 4)
  /// Required for the "Other (Please Specify)" row.
  otherDescription String?

  @@id([reportId, materialId])
}

// ------------------------------------------------------------------ import & audit

model ImportBatch {
  id            String    @id @default(cuid())
  fileName      String
  uploadedById  String
  uploadedBy    User      @relation(fields: [uploadedById], references: [id])
  uploadedAt    DateTime  @default(now())
  sheetCount    Int       @default(0)
  importedCount Int       @default(0)
  skippedCount  Int       @default(0)
  errorCount    Int       @default(0)
  log           Json?
  undoneAt      DateTime?

  reports Report[]
}

model AuditLog {
  id       String   @id @default(cuid())
  /// Kept (as plain text) even if the report is later deleted by an import undo.
  reportId String?
  report   Report?  @relation(fields: [reportId], references: [id], onDelete: SetNull)
  userId   String
  user     User     @relation(fields: [userId], references: [id])
  /// e.g. LOGIN, REPORT_CREATE, FIELD_CHANGE, STATUS_CHANGE, REOPEN, USER_CREATE, IMPORT_COMMIT
  action   String
  field    String?
  oldValue String?
  newValue String?
  at       DateTime @default(now())

  @@index([reportId, at])
  @@index([userId, at])
}

/// In-app notification (the header bell), one row per recipient. Written in the same transaction as the hand-off.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  reportId  String?
  report    Report?   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  title     String
  body      String
  /// In-app path opened on click, e.g. /reports/abc
  url       String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

/// A browser's Web Push subscription. The endpoint belongs to the browser, so signing in as someone else re-links it.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
